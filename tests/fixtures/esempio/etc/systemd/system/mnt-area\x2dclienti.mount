[Unit]
Description=Share aziendale //fs3.corp.esempio/AreaClienti
# Raggiungibile solo con la VPN Esempio attiva.
After=network-online.target
Wants=network-online.target

[Mount]
What=//fs3.corp.esempio/AreaClienti
Where=/mnt/area-clienti
Type=cifs
Options=credentials=/etc/samba/credentials/esempio,uid=1000,gid=1000,file_mode=0644,dir_mode=0755,iocharset=utf8,mfsymlinks,nofail,_netdev,soft
# Senza VPN il server non risponde: fallisci in fretta invece di bloccare chi legge la cartella.
TimeoutSec=20
